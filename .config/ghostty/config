# Tema: Cursed VHS (embutido no Ghostty).
# Volta para a anterior (Catppuccin Mocha): cp config.catppuccin config e cmd+shift+,
theme = Cursed VHS
term = xterm-256color

# Atalhos estilo Windows Terminal
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Libera Ctrl puro para o terminal (micro, fzf, etc)
macos-option-as-alt = true
